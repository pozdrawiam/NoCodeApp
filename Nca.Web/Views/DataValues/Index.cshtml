@using Nca.Domain.Features.DataDefinitions.Get
@model Nca.Domain.Features.DataValues.List.DataValueListQueryResult

@{
    var definition = (DataDefinitionGetQueryResult)ViewBag.Definition;
    
    ViewBag.Title = $"{definition.Name} data values";
}

@Html.ActionLink("Add", "Add", new { id = definition.Id })
<br>
<br>

<table>
    <thead>
    <tr>
        @foreach (var field in definition.Fields)
        {
            <th>@field.Name</th>
        }
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model.Values)
    {
        <tr>
            @foreach (var value in entry)
            {
                <td>@value</td>
            }
        </tr>
        <br>
    }
    </tbody>
</table>

@Html.ActionLink("Back", "Index", "DataDefinitions")
