@using Nca.Domain.Features.DataDefinitions.Add
@model DataDefinitionAddCmd

@{
    Layout = "_Form";
    ViewBag.Title = "Add data definition";
}

<div>
    @Html.LabelFor(m => m.Name)
    @Html.TextBoxFor(m => m.Name)
</div>
    
<fieldset>
    <legend>Fields</legend>
    @for (var i = 0; i < Model.Fields.Count; i++)
    {
        <div>
            @Html.LabelFor(m => m.Fields[i].Name, $"{i + 1} Name")
            @Html.TextBoxFor(m => m.Fields[i].Name)
        </div>
    }
    <button name="@(nameof(DataDefinitionAddCmd.AddField))" value="True">Add field</button>
</fieldset>
